{
  "name": "acos-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "node scripts/build-game.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:game": "pnpm --dir games/gonglian-fangxian/game test",
    "test:pack": "pnpm --dir mini-pack test",
    "test": "pnpm test:game && pnpm test:pack",
    "verify": "pnpm test:game && pnpm test:pack && pnpm build",
    "verify:full": "node scripts/verify-full.mjs"
  },
  "pnpm": {
    "overrides": {
      "@vivo-minigame/cli-packager": "1.27.23"
    }
  },
  "dependencies": {
    "commander": "^14.0.2",
    "esbuild": "^0.27.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "picocolors": "^1.1.1",
    "pixi.js": "^8.18.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@vivo-minigame/cli": "1.27.23",
    "@vitest/browser": "^4.0.8",
    "jsdom": "^27.2.0",
    "patch-package": "^8.0.1",
    "puppeteer": "file:mini-pack/stubs/puppeteer",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  }
}
